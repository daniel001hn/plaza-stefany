# Configurá estas variables en Vercel (Settings → Environment Variables)
# y localmente en un archivo .env (que NO se commitea — ver .gitignore).
#
# Las VITE_* van al cliente: la anon key es pública por diseño, pero solo
# tiene los permisos que le da Row Level Security en Supabase.
# Si RLS está apagado, esta key es una catástrofe — verificá que esté activo.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=<paste-anon-key-here-NOT-committed>

# Server-only (Vercel serverless / cron). NUNCA con prefijo VITE_.
# Solo accesible desde /api/* — el cliente no la puede leer.
SUPABASE_SERVICE_ROLE_KEY=<paste-service-role-here-NEVER-commit>

# Password del admin. Si no se setea, la app refuse admin login.
# Generala fuerte y guardala en password manager.
VITE_APP_PASSWORD=<set-in-vercel-env-vars>

# Secret para que solo Vercel Cron pueda invocar /api/tasa-bac.
# Generá uno random: openssl rand -hex 32
CRON_SECRET=<random-hex-32-bytes>
